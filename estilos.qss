/* ============================================================
   estilos.qss – Hoja de estilos para el editor del compilador
   Tema claro profesional, coherente entre todos los widgets.
   ============================================================ */

/* ---------- ventana principal ---------- */
QMainWindow {
    background-color: #f5f5f5;
}

/* ---------- barra de menú ---------- */
QMenuBar {
    background-color: #ffffff;
    color: #333333;
    padding: 2px 4px;
    border-bottom: 1px solid #d0d0d0;
    font-size: 13px;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e0e8f0;
}

QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #e0e8f0;
}

QMenu::separator {
    height: 1px;
    background-color: #d0d0d0;
    margin: 4px 12px;
}

/* ---------- barra de estado ---------- */
QStatusBar {
    background-color: #ffffff;
    color: #555555;
    border-top: 1px solid #d0d0d0;
    font-size: 12px;
    padding: 2px 4px;
}

/* ---------- widget central ---------- */
QWidget#centralwidget {
    background-color: #f5f5f5;
}

/* ---------- etiquetas "Código:" y "Salida:" ---------- */
QLabel#lblEditor,
QLabel#lblSalida {
    font-size: 14px;
    font-weight: bold;
    color: #333333;
    padding: 4px 0px 2px 4px;
}

/* ---------- botón Abrir (azul pastel) ---------- */
QPushButton#btnAbrir {
    background-color: #C5D9F7;
    color: #333333;
    border: 2px solid #A8C4E8;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    min-width: 80px;
}

QPushButton#btnAbrir:hover {
    background-color: #B0C8F0;
    border-color: #8BB0D8;
}

QPushButton#btnAbrir:pressed {
    background-color: #9AB8E6;
    border-color: #7AA0C8;
}

/* ---------- botón Guardar (verde pastel) ---------- */
QPushButton#btnGuardar {
    background-color: #A8F0C6;
    color: #333333;
    border: 2px solid #8BD8AE;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    min-width: 80px;
}

QPushButton#btnGuardar:hover {
    background-color: #93E6BA;
    border-color: #6EC89A;
}

QPushButton#btnGuardar:pressed {
    background-color: #7DDCAE;
    border-color: #5DB88A;
}

/* ---------- botón Analizar (durazno pastel) ---------- */
QPushButton#btnAnalizar {
    background-color: #FFCBA4;
    color: #333333;
    border: 2px solid #F0B088;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    min-width: 80px;
}

QPushButton#btnAnalizar:hover {
    background-color: #FFBE8E;
    border-color: #E89A6E;
}

QPushButton#btnAnalizar:pressed {
    background-color: #FFB078;
    border-color: #D88A5E;
}

/* ---------- botón principal "▶ Ejecutar" (rosa pastel) ---------- */
QPushButton#btnEjecutar {
    background-color: #FF8FA3;
    color: #ffffff;
    border: 2px solid #E07090;
    border-radius: 8px;
    padding: 6px 20px;
    font-size: 13px;
    font-weight: bold;
    min-width: 100px;
}

QPushButton#btnEjecutar:hover {
    background-color: #FF7A96;
    border-color: #D06080;
}

QPushButton#btnEjecutar:pressed {
    background-color: #FF6588;
    border-color: #C05070;
}

/* ---------- botón Limpiar (amarillo pastel) ---------- */
QPushButton#btnLimpiar {
    background-color: #E8F8C5;
    color: #333333;
    border: 2px solid #C8E8A0;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    min-width: 80px;
}

QPushButton#btnLimpiar:hover {
    background-color: #D8F0B0;
    border-color: #B0D888;
}

QPushButton#btnLimpiar:pressed {
    background-color: #C8E898;
    border-color: #A0C878;
}

/* ---------- layout de botones ---------- */
QHBoxLayout#layoutBotones {
    spacing: 8px;
    margin: 8px 8px 4px 8px;
}

/* ---------- editor de código ---------- */
EditorCodigo#txtEditor {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #b3d4fc;
    selection-color: #1e1e1e;
}

/* ---------- área de salida ---------- */
QPlainTextEdit#txtSalida {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #264f78;
    selection-color: #d4d4d4;
    font-size: 11px;
}

/* ---------- layout vertical principal ---------- */
QVBoxLayout#verticalLayout {
    spacing: 6px;
    margin: 8px;
}

/* ---------- diálogos de archivo ---------- */
QFileDialog {
    background-color: #ffffff;
}

QFileDialog QLabel {
    color: #333333;
}

QFileDialog QLineEdit {
    border-radius: 4px;
    padding: 4px;
    border: 1px solid #c0c0c0;
}

QFileDialog QPushButton {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px 12px;
    min-width: 60px;
}

QFileDialog QPushButton:hover {
    background-color: #e8edf2;
}

QFileDialog QPushButton#okButton,
QFileDialog QPushButton#openButton,
QFileDialog QPushButton#saveButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
}

QFileDialog QPushButton#okButton:hover,
QFileDialog QPushButton#openButton:hover,
QFileDialog QPushButton#saveButton:hover {
    background-color: #1d4ed8;
}

QFileDialog QListView,
QFileDialog QTreeView {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    outline: none;
}

QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected {
    background-color: #b3d4fc;
    color: #1e1e1e;
}

QFileDialog QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 12px;
    border-radius: 6px;
}

QFileDialog QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 20px;
}

QFileDialog QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

/* ---------- barras de desplazamiento generales ---------- */
QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 12px;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #f0f0f0;
    height: 12px;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------- mensajes (QMessageBox) ---------- */
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #333333;
}

QMessageBox QPushButton {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px 16px;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background-color: #e8edf2;
}
