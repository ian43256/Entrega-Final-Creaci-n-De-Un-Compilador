/* ============================================================
   estilos.qss – Hoja de estilos para el editor del compilador
   Tema claro profesional, coherente entre todos los widgets.
   ============================================================ */

/* ---------- ventana principal ---------- */
QMainWindow {
    background-color: #f5f5f5;
}

/* ---------- barra de menú ---------- */
QMenuBar {
    background-color: #ffffff;
    color: #333333;
    padding: 2px 4px;
    border-bottom: 1px solid #d0d0d0;
    font-size: 13px;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e0e8f0;
}

QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #e0e8f0;
}

QMenu::separator {
    height: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #C5D9F7, stop:0.5 #FFCBA4, stop:1 #FF8FA3);
    margin: 6px 12px;
    border-radius: 1px;
}

/* ---------- tooltips personalizados ---------- */
QToolTip {
    background-color: #ffffff;
    color: #333333;
    border: 2px solid #C5D9F7;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ---------- barra de estado ---------- */
QStatusBar {
    background-color: #ffffff;
    color: #555555;
    border-top: 2px solid #e0e8f0;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 8px;
}

QStatusBar::item {
    border: none;
    padding: 2px 8px;
}

/* ---------- widget central ---------- */
QWidget#centralwidget {
    background-color: #f5f5f5;
}

/* ---------- etiquetas "Código:" y "Salida:" ---------- */
QLabel#lblEditor {
    font-size: 14px;
    font-weight: bold;
    color: #2c3e50;
    padding: 8px 12px 6px 14px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0f0f0, stop:1 #d8d8d8);
    border: 1px solid #c8c8c8;
    border-left: 4px solid #9e9e9e;
    border-radius: 8px;
    min-height: 28px;
}

QLabel#lblSalida {
    font-size: 14px;
    font-weight: bold;
    color: #2c3e50;
    padding: 8px 12px 6px 14px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0f0f0, stop:1 #d8d8d8);
    border: 1px solid #c8c8c8;
    border-left: 4px solid #9e9e9e;
    border-radius: 8px;
    min-height: 28px;
}

/* ---------- botón Abrir (azul pastel) ---------- */
QPushButton#btnAbrir {
    background-color: #C5D9F7;
    color: #333333;
    border: 2px solid #A8C4E8;
    border-bottom: 3px solid #8BB0D8;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 80px;
}

QPushButton#btnAbrir:hover {
    background-color: #B0C8F0;
    border-color: #8BB0D8;
    border-bottom-color: #7AA0C8;
}

QPushButton#btnAbrir:pressed {
    background-color: #9AB8E6;
    border: 2px solid #7AA0C8;
    border-bottom: 2px solid #6A90B8;
    padding: 8px 18px 6px 18px;
}

/* ---------- botón Guardar (verde pastel) ---------- */
QPushButton#btnGuardar {
    background-color: #A8F0C6;
    color: #333333;
    border: 2px solid #8BD8AE;
    border-bottom: 3px solid #6EC89A;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 80px;
}

QPushButton#btnGuardar:hover {
    background-color: #93E6BA;
    border-color: #6EC89A;
    border-bottom-color: #5DB88A;
}

QPushButton#btnGuardar:pressed {
    background-color: #7DDCAE;
    border: 2px solid #5DB88A;
    border-bottom: 2px solid #4DA87A;
    padding: 8px 18px 6px 18px;
}

/* ---------- botón Analizar (durazno pastel) ---------- */
QPushButton#btnAnalizar {
    background-color: #FFCBA4;
    color: #333333;
    border: 2px solid #F0B088;
    border-bottom: 3px solid #E89A6E;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 80px;
}

QPushButton#btnAnalizar:hover {
    background-color: #FFBE8E;
    border-color: #E89A6E;
    border-bottom-color: #D88A5E;
}

QPushButton#btnAnalizar:pressed {
    background-color: #FFB078;
    border: 2px solid #D88A5E;
    border-bottom: 2px solid #C87A4E;
    padding: 8px 18px 6px 18px;
}

/* ---------- botón principal "▶ Ejecutar" (rosa pastel) ---------- */
QPushButton#btnEjecutar {
    background-color: #FF8FA3;
    color: #ffffff;
    border: 2px solid #E07090;
    border-bottom: 3px solid #D06080;
    border-radius: 10px;
    padding: 8px 22px;
    font-size: 14px;
    font-weight: bold;
    min-width: 100px;
}

QPushButton#btnEjecutar:hover {
    background-color: #FF7A96;
    border-color: #D06080;
    border-bottom-color: #C05070;
}

QPushButton#btnEjecutar:pressed {
    background-color: #FF6588;
    border: 2px solid #C05070;
    border-bottom: 2px solid #B04060;
    padding: 8px 22px 6px 22px;
}

/* ---------- botón Limpiar (amarillo pastel) ---------- */
QPushButton#btnLimpiar {
    background-color: #E8F8C5;
    color: #333333;
    border: 2px solid #C8E8A0;
    border-bottom: 3px solid #B0D888;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 80px;
}

QPushButton#btnLimpiar:hover {
    background-color: #D8F0B0;
    border-color: #B0D888;
    border-bottom-color: #A0C878;
}

QPushButton#btnLimpiar:pressed {
    background-color: #C8E898;
    border: 2px solid #A0C878;
    border-bottom: 2px solid #90B868;
    padding: 8px 18px 6px 18px;
}

/* ---------- layout de botones ---------- */
QHBoxLayout#layoutBotones {
    spacing: 10px;
    margin: 10px 10px 6px 10px;
}

/* ---------- layout vertical principal ---------- */
QVBoxLayout#verticalLayout {
    spacing: 8px;
    margin: 10px;
}

/* ---------- editor de código ---------- */
EditorCodigo#txtEditor {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f8f9fa);
    color: #1e1e1e;
    border: 2px solid #d0d0d0;
    border-top: 3px solid #C5D9F7;
    border-radius: 10px;
    padding: 12px;
    selection-background-color: #b3d4fc;
    selection-color: #1e1e1e;
    font-size: 12px;
}

EditorCodigo#txtEditor:focus {
    border: 2px solid #A8C4E8;
    border-top: 3px solid #7BAFD4;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f0f4f8);
}

/* ---------- área de salida ---------- */
QPlainTextEdit#txtSalida {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #333333, stop:1 #252525);
    color: #d4d4d4;
    border: 2px solid #555555;
    border-top: 3px solid #9e9e9e;
    border-radius: 10px;
    padding: 12px;
    selection-background-color: #264f78;
    selection-color: #d4d4d4;
    font-size: 11px;
}

/* ---------- layout vertical principal ---------- */
QVBoxLayout#verticalLayout {
    spacing: 6px;
    margin: 8px;
}

/* ---------- diálogos de archivo ---------- */
QFileDialog {
    background-color: #ffffff;
}

QFileDialog QLabel {
    color: #333333;
}

QFileDialog QLineEdit {
    border-radius: 4px;
    padding: 4px;
    border: 1px solid #c0c0c0;
}

QFileDialog QPushButton {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px 12px;
    min-width: 60px;
}

QFileDialog QPushButton:hover {
    background-color: #e8edf2;
}

QFileDialog QPushButton#okButton,
QFileDialog QPushButton#openButton,
QFileDialog QPushButton#saveButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
}

QFileDialog QPushButton#okButton:hover,
QFileDialog QPushButton#openButton:hover,
QFileDialog QPushButton#saveButton:hover {
    background-color: #1d4ed8;
}

QFileDialog QListView,
QFileDialog QTreeView {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    outline: none;
}

QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected {
    background-color: #b3d4fc;
    color: #1e1e1e;
}

QFileDialog QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 12px;
    border-radius: 6px;
}

QFileDialog QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 20px;
}

QFileDialog QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

/* ---------- barras de desplazamiento generales ---------- */
QScrollBar:vertical {
    background-color: #e8edf2;
    width: 14px;
    border-radius: 7px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #A8C4E8;
    border-radius: 7px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8BB0D8;
}

QScrollBar::handle:vertical:pressed {
    background-color: #7BAFD4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #e8edf2;
    height: 14px;
    border-radius: 7px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #A8C4E8;
    border-radius: 7px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #8BB0D8;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #7BAFD4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------- mensajes (QMessageBox) ---------- */
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #333333;
}

QMessageBox QPushButton {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px 16px;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background-color: #e8edf2;
}
